<?xml version="1.0" ?>
<robot name="My robot" xmlns:xacro="http://ros.org/wiki/xacro">
    

    <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

    <link name="base_link">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <box size="1.2 0.7 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <link name="base_footprint"></link>
    <joint name="base_link_to_base_footprint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="base_footprint"/>
    </joint>


    <link name="mount_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.02 0.03 0.16"/>
            </geometry>
        </visual>
    </link>

    <joint name="base_link_to_mount_link" type="fixed">
        <origin xyz="0.535 0 0.2" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="mount_link"/>
    </joint>

    <joint name="mount_link_to_lidar_link" type="fixed">
        <origin xyz="0.0 0 0.1" rpy="0 -0.05 3.1415"/>
        <parent link="mount_link"/>
        <child link="lidar_link"/>
    </joint>
    <joint name="mount_link_to_gps" type="fixed">
        <parent link="base_link"/>
        <child link="gps"/>
        <origin xyz="0.155 0 0" rpy="0 0 0"/>
    </joint>
    
    <link name="gps">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </visual>
    </link>

    <link name="lidar_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </visual>
    </link>

    <joint name="mount_link_to_cam_link" type="fixed">
        <origin xyz="0 0 -0.05" rpy="0 0 0"/>
        <parent link="mount_link"/>
        <child link="cam_link"/>
    </joint>

    <link name="cam_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.1 0.05"/>
            </geometry>
        </visual>
    </link>

    <joint name="cam_link_to_rs1_link" type="fixed">
        <origin xyz="0 0.07 0" rpy="0 0 0.5"/>
        <parent link="cam_link"/>
        <child link="rs1_link"/>
    </joint>

    <link name="rs1_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.1 0.05"/>
            </geometry>
        </visual>
    </link>




    <joint name="cam_link_to_rs2_link" type="fixed">
        <origin xyz="0 -0.07 0" rpy="0 0 -0.5"/>
        <parent link="cam_link"/>
        <child link="rs2_link"/>
    </joint>

    <link name="rs2_link">
        <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.05 0.1 0.05"/>
            </geometry>
        </visual>
    </link>

    <link name="fl_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_fl_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="fl_wheel"/>
        <origin xyz="0.5 0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>

    <link name="ml_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_ml_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="ml_wheel"/>
        <origin xyz="0 0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>
    <link name="bl_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_bl_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="bl_wheel"/>
        <origin xyz="-0.5 0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>
    
    <link name="fr_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_fr_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="fr_wheel"/>
        <origin xyz="0.5 -0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>

    <link name="mr_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_mr_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="mr_wheel"/>
        <origin xyz="0 -0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>
    <link name="br_wheel">
        <visual>
        <origin xyz="0 0 0"/>
            <geometry>
                <cylinder length="0.15" radius="0.17"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <joint name="base_link_to_br_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="br_wheel"/>
        <origin xyz="-0.5 -0.5 -0.2" rpy="1.5708 0 0"/>
    </joint>

</robot>